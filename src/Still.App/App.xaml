<Application x:Class="Still.App.ClockApplication" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#EFF1EE"/><SolidColorBrush x:Key="Muted" Color="#AEB8B3"/>
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#141C20"/></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
    <Style TargetType="Label"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Padding" Value="0,0,0,7"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F0F3F0"/><Setter Property="Background" Value="#2C3B40"/><Setter Property="BorderBrush" Value="#51625E"/><Setter Property="Padding" Value="16,9"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#405650"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#D6E9C9"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="9,5"/><Setter Property="Foreground" Value="#14201D"/><Setter Property="Background" Value="#E3E9E5"/></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F0F3F0"/><Setter Property="Background" Value="#233136"/><Setter Property="BorderBrush" Value="#63746D"/><Setter Property="Padding" Value="9,7"/><Setter Property="CaretBrush" Value="White"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Margin" Value="0,8,0,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="Slider"><Setter Property="Margin" Value="0,4,0,6"/><Setter Property="IsSnapToTickEnabled" Value="True"/><Setter Property="AutoToolTipPlacement" Value="BottomRight"/></Style>
    <Style TargetType="Expander"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Margin" Value="0,14,0,0"/></Style>
  </Application.Resources>
</Application>
