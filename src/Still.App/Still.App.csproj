<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings><ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>still.ico</ApplicationIcon><AssemblyName>Still</AssemblyName>
    <Version>2.7.0</Version><Description>A futuristic, customizable clock for your desktop</Description>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Still.Core/Still.Core.csproj"/><Resource Include="still.ico"/></ItemGroup>
  <!-- Bundled SIL OFL fonts (Quicksand, Michroma); their licence texts ship beside the app in licences/fonts. -->
  <ItemGroup>
    <Resource Include="Fonts/*.ttf"/>
    <None Include="Fonts/OFL-*.txt" Link="licences/fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
