<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Still.Linux.ClockApplication" RequestedThemeVariant="Dark" Name="Still">
  <!-- Dark defaults; Ui.Apply swaps these (and the Fluent variant) for the Dark/Light/System choice. -->
  <Application.Resources>
    <SolidColorBrush x:Key="UiWindow" Color="#05080F"/>
    <SolidColorBrush x:Key="UiControl" Color="#0A1220"/>
    <SolidColorBrush x:Key="UiHover" Color="#0D2B3D"/>
    <SolidColorBrush x:Key="UiBorder" Color="#1D3448"/>
    <SolidColorBrush x:Key="UiInk" Color="#E6F7FF"/>
    <SolidColorBrush x:Key="UiMuted" Color="#7F9BB0"/>
    <SolidColorBrush x:Key="UiAccent" Color="#00E5FF"/>
    <SolidColorBrush x:Key="UiOnAccent" Color="#000000"/>
    <SolidColorBrush x:Key="UiExpander" Color="#080F1A"/>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#00E5FF" RegionColor="#05080F" AltHigh="#05080F" BaseHigh="#E6F7FF"
                               ChromeMediumLow="#0A1220" ChromeLow="#0A1220" ChromeMedium="#0D2B3D" ListLow="#0D2B3D" ListMedium="#12364C" />
        <ColorPaletteResources x:Key="Light" Accent="#00778A" RegionColor="#F3F6FA" AltHigh="#FFFFFF" BaseHigh="#0B1A26"
                               ChromeMediumLow="#FFFFFF" ChromeLow="#F3F6FA" ChromeMedium="#E2F4F8" ListLow="#E2F4F8" ListMedium="#CFEAF0" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <Style Selector="Window"><Setter Property="FontFamily" Value="fonts:Inter#Inter"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource UiInk}"/></Style>
    <Style Selector="Button"><Setter Property="Background" Value="{DynamicResource UiControl}"/><Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="16,9"/><Setter Property="Foreground" Value="{DynamicResource UiInk}"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource UiHover}"/><Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/></Style>
    <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource UiAccent}"/><Setter Property="Foreground" Value="{DynamicResource UiOnAccent}"/><Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource UiAccent}"/><Setter Property="Foreground" Value="{DynamicResource UiOnAccent}"/><Setter Property="Opacity" Value="0.85"/></Style>
    <Style Selector="Button.coffee"><Setter Property="Background" Value="#FFDD00"/><Setter Property="Foreground" Value="#1A140A"/><Setter Property="BorderBrush" Value="#E6C200"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.coffee:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#FFE74D"/><Setter Property="Foreground" Value="#1A140A"/><Setter Property="BorderBrush" Value="#C9A900"/></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="38"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Background" Value="{DynamicResource UiControl}"/><Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/><Setter Property="MaxDropDownHeight" Value="320"/></Style>
    <Style Selector="TextBox"><Setter Property="Background" Value="{DynamicResource UiControl}"/><Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/></Style>
    <Style Selector="Label"><Setter Property="Foreground" Value="{DynamicResource UiInk}"/><Setter Property="Padding" Value="0,0,0,6"/></Style>
    <Style Selector="Slider"><Setter Property="Margin" Value="0,-4,0,0"/></Style>
    <Style Selector="ColorPicker"><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
    <Style Selector="Expander"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Background" Value="{DynamicResource UiExpander}"/></Style>
  </Application.Styles>
</Application>
