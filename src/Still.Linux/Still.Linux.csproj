<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0</TargetFramework>
    <AssemblyName>still</AssemblyName><RootNamespace>Still.Linux</RootNamespace>
    <Version>2.3.0</Version><Description>A futuristic, customizable clock for your desktop</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23"/>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23"/>
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23"/>
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.23"/>
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Still.Core/Still.Core.csproj"/>
    <AvaloniaResource Include="Assets/**"/>
  </ItemGroup>
</Project>
